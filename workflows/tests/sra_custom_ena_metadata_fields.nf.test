nextflow_workflow {

    name "Test workflow: workflows/fetchngs.nf"
    script "../fetchngs.nf"
    workflow "FETCHNGS"
    tag "SRA_CUSTOM_ENA_METADATA_FIELDS"

    // Dependencies
    tag "SRA_IDS_TO_RUNINFO"
    tag "SRA_RUNINFO_TO_FTP"
    tag "SRA_FASTQ_FTP"
    tag "SRA_TO_SAMPLESHEET"
    tag "MULTIQC_MAPPINGS_CONFIG"

    test("Parameters: --nf_core_pipeline rnaseq --ena_metadata_fields ... --sample_mapping_fields ...") {

        when {
            workflow {
                """
                input[0] = channel.of("DRX026011", "ERX1234253", "SRX6725035")
                input[1] = "${outputDir}"
                input[2] = []
                input[3] = 'ftp'
                input[4] = 'run_accession,experiment_accession,library_layout,fastq_ftp,fastq_md5'
                input[5] = 'rnaseq'
                input[6] = 'auto'
                input[7] = 'run_accession,library_layout'
                input[8] = false
                """
            }
        }

        then {
            // csv_file: Just the samplesheet
            def csv_file = path(outputDir + '/samplesheet/samplesheet.csv').csv()

            // Sanitize sra_metadata to remove unstable output directory paths
            def sra_metadata = workflow.out.sra_metadata.collect { meta ->
                def m = meta instanceof List ? meta[0] : meta
                def fastq1 = m.fastq_1 ? (m.fastq_1 instanceof List ? path(m.fastq_1[0]).fileName.toString() : path(m.fastq_1).fileName.toString()) : ''
                def fastq2 = m.fastq_2 ? (m.fastq_2 instanceof List ? path(m.fastq_2[0]).fileName.toString() : path(m.fastq_2).fileName.toString()) : ''
                return [m + [fastq_1: fastq1] + [fastq_2: fastq2]]
            }

            assert workflow.success
            assertAll(
                { assert snapshot(
                    // Samplesheet
                    "samplesheet.csv:md5," + csv_file.sort().table.collect { row -> [row.getString("sample"), row.getString("fastq_1").replaceAll(outputDir, ""), row.getString("fastq_2").replaceAll(outputDir, "")].join(",") }.join("\n").md5(),
                    workflow.out.mappings,
                    workflow.out.sample_mappings,
                    sra_metadata,
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeFromYamlMap("${outputDir}/pipeline_info/nf_core_fetchngs_software_versions.yml", "Workflow"),
                ).match() }
            )
        }
    }
}
