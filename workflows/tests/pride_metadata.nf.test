nextflow_workflow {

    name "Test workflow: workflows/fetchngs.nf"
    script "../fetchngs.nf"
    workflow "FETCHNGS"
    tag "PRIDE_METADATA"

    // Dependencies
    tag "pridepy/streamfilesmetadata"
    tag "pride_fetch"

    test("PRIDE id: metadata only") {

        when {
            workflow {
                """
                input[0] = channel.of(["pride", "PXD000001"])
                input[1] = "${outputDir}"
                input[2] = []
                input[3] = 'ftp'
                input[4] = ''
                input[5] = ''
                input[6] = 'auto'
                input[7] = ''
                input[8] = false
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.pride_metadata.collect { meta, json -> [meta, path(json).json.collect { file -> file.fileName }.sort()] },
                    removeFromYamlMap("${outputDir}/pipeline_info/nf_core_fetchngs_software_versions.yml", "Workflow"),
                ).match() }
            )
        }
    }
}
