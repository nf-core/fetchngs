nextflow_process {

    name "Test process: SRA_RUNINFO_TO_FTP"
    script "../main.nf"
    process "SRA_RUNINFO_TO_FTP"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + 'tsv/SRR13191702.runinfo.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }

    test("Should handle edge cases like the original Python script") {

        when {
            process {
                """
                input[0] = file('${moduleTestDir}/edge_cases.runinfo.tsv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(sanitizeOutput(process.out)).match() }
            )
        }
    }
}
