nextflow_function {

    name "Test Functions"
    script "subworkflows/local/utils_nfcore_fetchngs_pipeline/main.nf"
    tag "UTILS_NFCORE_FETCHNGS_PIPELINE"

    test("Function sraCheckENAMetadataFields [success]") {

        function "sraCheckENAMetadataFields"

        when {
            function {
                """
                input[0] = 'run_accession,experiment_accession,library_layout,fastq_ftp,fastq_md5'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("Function sraCheckENAMetadataFields [failure]") {

        function "sraCheckENAMetadataFields"

        when {
            function {
                """
                input[0] = 'run_accession,experiment_accession,library_layout,fastq_ftp'
                """
            }
        }

        then {
            assertAll(
                { assert function.failed }
            )
        }
    }

    test("Function sraCurateSamplesheetWarn") {

        function "sraCurateSamplesheetWarn"

        then {
            assertAll(
                { assert function.success },
                { assert snapshot(function.result).match() }
            )
        }
    }

    test("Function dataTypeForId [SRA run]") {

        function "dataTypeForId"

        when {
            function {
                """
                input[0] = 'SRR9984183'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'ngs' }
            )
        }
    }

    test("Function dataTypeForId [GEO series]") {

        function "dataTypeForId"

        when {
            function {
                """
                input[0] = 'GSE214215'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == 'ngs' }
            )
        }
    }

    test("Function dataTypeForId [unknown id]") {

        function "dataTypeForId"

        when {
            function {
                """
                input[0] = 'PXD012345'
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == null }
            )
        }
    }

    test("Function getSampleMappingFields [success]") {

        function "getSampleMappingFields"

        when {
            function {
                """
                input[0] = 'Run_Accession, experiment_accession'
                input[1] = ['sample', 'fastq_1', 'run_accession', 'experiment_accession']
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['sample', 'run_accession', 'experiment_accession'] }
            )
        }
    }

    test("Function getSampleMappingFields [failure]") {

        function "getSampleMappingFields"

        when {
            function {
                """
                input[0] = 'not_a_column'
                input[1] = ['sample', 'fastq_1', 'run_accession']
                """
            }
        }

        then {
            assertAll(
                { assert !function.success },
                { assert function.stdout.any { line -> line.contains("Invalid option for '--sample_mapping_fields': not_a_column") } }
            )
        }
    }

    test("Function toCsvLines") {

        function "toCsvLines"

        when {
            function {
                """
                input[0] = ['sample', 'fastq_1']
                input[1] = [
                    [sample: 'SRX2', fastq_1: 'b.fastq.gz', run_accession: 'SRR2'],
                    [sample: 'SRX1', fastq_1: 'a.fastq.gz', run_accession: 'SRR1'],
                ]
                """
            }
        }

        then {
            assertAll(
                { assert function.success },
                { assert function.result == ['"sample","fastq_1"', '"SRX1","a.fastq.gz"', '"SRX2","b.fastq.gz"'] }
            )
        }
    }
}
