nextflow_workflow {

    name "Test workflow: CHANNEL_SRA_CREATE_CSV"
    script "../main.nf"
    workflow "CHANNEL_SRA_CREATE_CSV"

    test("Should create samplesheet and mappings") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    id:'ERX1188904_ERR1109373',
                    run_accession:'ERR1109373',
                    experiment_accession:'ERX1188904',
                    sample_accession:'SAMEA3643867',
                    experiment_alias:'ena-EXPERIMENT-CAM-03-11-2015-17:01:52:847-7',
                    run_alias:'ena-RUN-CAM-03-11-2015-17:01:52:847-7',
                    sample_alias:'sample_56',
                    study_alias:'ena-STUDY-CAM-02-11-2015-17:42:24:189-13',
                    library_layout:'PAIRED',
                    experiment_title:'Illumina HiSeq 2500 paired end sequencing',
                    sample_title:'RNA-Seq reads mapped onto L. Boulardi Toti-like virus genome',
                    sample_description:'RNA-Seq reads mapped onto L. Boulardi Toti-like virus genome',
                    fastq_md5:'8d7d7b854d0207d1226477a30103fade;9fd57225d6c07a31843276d6df9b15c0;5a62e8f785687dce890cfb4fe3e607f9',
                    fastq_ftp:'ftp.sra.ebi.ac.uk/vol1/fastq/ERR110/003/ERR1109373/ERR1109373.fastq.gz;ftp.sra.ebi.ac.uk/vol1/fastq/ERR110/003/ERR1109373/ERR1109373_1.fastq.gz;ftp.sra.ebi.ac.uk/vol1/fastq/ERR110/003/ERR1109373/ERR1109373_2.fastq.gz',
                    fastq_1:'./results/fastq/ERX1188904_ERR1109373_1.fastq.gz',
                    fastq_2:'./results/fastq/ERX1188904_ERR1109373_2.fastq.gz',
                    md5_1:'9fd57225d6c07a31843276d6df9b15c0',
                    md5_2:'5a62e8f785687dce890cfb4fe3e607f9',
                    single_end:false
                ])
                input[1] = 'rnaseq'
                input[2] = 'auto'
                input[3] = 'experiment_accession,run_accession,sample_accession,experiment_alias,run_alias,sample_alias,experiment_title,sample_title,sample_description'
                input[4] = "${outputDir}"
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(sanitizeOutput(workflow.out)).match() }
            )
        }
    }

    test("mag: short reads and long reads in their own columns") {

        when {
            workflow {
                """
                input[0] = channel.of(
                    [
                        id:'DRX026011_DRR028935',
                        run_accession:'DRR028935',
                        study_accession:'PRJDB3392',
                        instrument_platform:'ILLUMINA',
                        fastq_1:'./results/fastq/DRX026011_DRR028935_1.fastq.gz',
                        fastq_2:'./results/fastq/DRX026011_DRR028935_2.fastq.gz',
                        md5_1:'',
                        md5_2:'',
                        single_end:false
                    ],
                    [
                        id:'SRX34639654_SRR39975833',
                        run_accession:'SRR39975833',
                        study_accession:'PRJNA1506675',
                        instrument_platform:'OXFORD_NANOPORE',
                        fastq_1:'./results/fastq/SRX34639654_SRR39975833.fastq.gz',
                        fastq_2:'',
                        md5_1:'',
                        md5_2:'',
                        single_end:true
                    ]
                )
                input[1] = 'mag'
                input[2] = 'auto'
                input[3] = ''
                input[4] = "${outputDir}"
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(path(workflow.out.samplesheet[0]).readLines()).match() }
            )
        }
    }
}
