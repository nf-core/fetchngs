nextflow_workflow {

    name "Test workflow: FETCH_NGS"
    script "../main.nf"
    workflow "FETCH_NGS"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "fetch_ngs"

    // Dependencies
    tag "SRA_IDS_TO_RUNINFO"
    tag "SRA_RUNINFO_TO_FTP"

    test("Should emit metadata and samplesheet rows - skip_fastq_download") {

        when {
            workflow {
                """
                input[0] = channel.of("DRX026011", "ERX1234253", "SRX6725035")
                input[1] = "${outputDir}"
                input[2] = []
                input[3] = 'ftp'
                input[4] = ''
                input[5] = ''
                input[6] = 'auto'
                input[7] = true
                """
            }
        }

        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.metadata.sort { meta -> meta.id },
                    workflow.out.samplesheet_rows.sort { row -> row.run_accession },
                ).match() }
            )
        }
    }
}
