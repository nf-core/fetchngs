/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                                Local module configs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: 'ASPERA_CLI' {
        ext.args = '-QT -l 300m -P33001'
        publishDir = [
            [
                path: { "${params.outdir}/ngs/fastq" },
                mode: params.publish_dir_mode,
                pattern: "*.fastq.gz"
            ],
            [
                path: { "${params.outdir}/ngs/fastq/md5" },
                mode: params.publish_dir_mode,
                pattern: "*.md5"
            ]
        ]
    }

    withName: 'MULTIQC_MAPPINGS_CONFIG' {
        publishDir = [
            path: { "${params.outdir}/ngs/samplesheet" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SRA_FASTQ_FTP' {
        ext.args = '-t 5 -nv -w 5 --random-wait -c -T 60'
        publishDir = [
            [
                path: { "${params.outdir}/ngs/fastq" },
                mode: params.publish_dir_mode,
                pattern: "*.fastq.gz"
            ],
            [
                path: { "${params.outdir}/ngs/fastq/md5" },
                mode: params.publish_dir_mode,
                pattern: "*.md5"
            ]
        ]
    }

    withName: 'SRA_IDS_TO_RUNINFO' {
        publishDir = [
            path: { "${params.outdir}/ngs/metadata" },
            enabled: false
        ]
    }

    withName: 'SRA_RUNINFO_TO_FTP' {
        publishDir = [
            path: { "${params.outdir}/ngs/metadata" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                                Nf-core module configs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: 'CUSTOM_SRATOOLSNCBISETTINGS' {
        publishDir = [
            path: { "${params.outdir}/ngs/custom" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTQDL' {
        publishDir = [
            [
                path: { "${params.outdir}/ngs/fastq" },
                pattern: "*.fastq.gz"
            ],
            [
                path: { "${params.outdir}/ngs/metadata" },
                pattern: "*-run-info.tsv"
            ],
            [
                path: { "${params.outdir}/ngs/metadata" },
                pattern: "*-run-mergers.tsv"
            ]
        ]
    }

    withName: SRATOOLS_FASTERQDUMP {
        ext.args = '--split-files --include-technical'
        publishDir = [
            path: { "${params.outdir}/ngs/fastq" },
            mode: params.publish_dir_mode,
            pattern: "*.fastq.gz"
        ]
    }

    withName: SRATOOLS_PREFETCH {
        publishDir = [
            path: { "${params.outdir}/ngs/sra" },
            enabled: false
        ]
    }
}
